# Omarchy titlebars: draw the bar with the blur it already asks for
# (omacom/omarchy-hyprland-titlebars#8), and open the stencil mask before
# clearing it, which glassy layers leave shut (from #12).
diff --git barDeco.cpp barDeco.cpp
index 40b0271..5a352b5 100644
--- barDeco.cpp
+++ barDeco.cpp
@@ -611,6 +611,7 @@ void COmarchyFloatingHyprBar::renderPass(PHLMONITOR pMonitor, const float &a) {
     if (windowBox.w < 1 || windowBox.h < 1)
       return;
 
+    glStencilMask(0xFF);
     glClearStencil(0);
     glClear(GL_STENCIL_BUFFER_BIT);
 
@@ -629,7 +630,7 @@ void COmarchyFloatingHyprBar::renderPass(PHLMONITOR pMonitor, const float &a) {
     glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
   }
 
-  g_pHyprOpenGL->renderRect(titleBarBox, color, {.round = static_cast<int>(scaledRounding), .roundingPower = PWINDOW->roundingPower()});
+  g_pHyprOpenGL->renderRect(titleBarBox, color, {.round = static_cast<int>(scaledRounding), .roundingPower = PWINDOW->roundingPower(), .blur = SHOULDBLUR, .blurA = a});
 
   // render title
   // The app's name is steadier than a window title, which for a web app is often
